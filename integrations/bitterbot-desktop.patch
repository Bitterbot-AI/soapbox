+import { createServer, type Server } from "node:http";
+import { afterEach, describe, expect, it } from "vitest";
+import { SoapboxClient, soapboxClientFromEnv } from "./soapbox-client.js";
+
+const token = "test-token-00000000000000000000000000";
+const servers: Server[] = [];
+afterEach(async () => {
+  await Promise.all(
+    servers
+      .splice(0)
+      .map((server) => new Promise<void>((resolve) => server.close(() => resolve()))),
+  );
+});
+
+async function serve(handler: Parameters<typeof createServer>[0]) {
+  const server = createServer(handler);
+  servers.push(server);
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  if (!address || typeof address === "string") throw new Error("No server address");
+  return `http://127.0.0.1:${address.port}`;
+}
+
+describe("Soapbox client", () => {
+  it("is disabled until explicitly enabled", () => {
+    expect(soapboxClientFromEnv({})).toBeNull();
+    expect(() => soapboxClientFromEnv({ BITTERBOT_SOAPBOX_ENABLED: "1" })).toThrow("TOKEN");
+  });
+  it("rejects remote plaintext, embedded credentials and paths", () => {
+    for (const url of [
+      "http://example.com",
+      "https://u:p@example.com",
+      "https://example.com/private",
+    ]) {
+      expect(() => new SoapboxClient(url, token)).toThrow();
+    }
+  });
+  it("authenticates on the server side and checks protocol version", async () => {
+    const url = await serve((req, res) => {
+      expect(req.headers.authorization).toBe(`Bearer ${token}`);
+      res.setHeader("Content-Type", "application/json");
+      res.end(JSON.stringify({ api_version: 1, settlement: "test_credits" }));
+    });
+    expect(await new SoapboxClient(url, token).status()).toMatchObject({
+      enabled: true,
+      api_version: 1,
+    });
+  });
+  it("does not forward credentials through redirects", async () => {
+    let leaked = false;
+    const destination = await serve((_req, res) => {
+      leaked = true;
+      res.end("{}");
+    });
+    const source = await serve((_req, res) => {
+      res.writeHead(302, { Location: destination });
+      res.end();
+    });
+    await expect(new SoapboxClient(source, token).status()).rejects.toThrow();
+    expect(leaked).toBe(false);
+  });
+  it("preserves application errors and disallows path injection", async () => {
+    const url = await serve((_req, res) => {
+      res.writeHead(400);
+      res.end('{"error":"insufficient test credits"}');
+    });
+    const client = new SoapboxClient(url, token);
+    await expect(client.request("POST", "/v1/jobs", {})).rejects.toThrow(
+      "insufficient test credits",
+    );
+    await expect(client.request("GET", "//other-host/v1/jobs")).rejects.toThrow("path");
+  });
+});
diff --git a/src/infra/soapbox-client.ts b/src/infra/soapbox-client.ts
new file mode 100644
index 0000000..3111eb4
--- /dev/null
+++ b/src/infra/soapbox-client.ts
@@ -0,0 +1,179 @@
+/** Versioned adapter to the standalone Soapbox service. Secrets stay in the gateway. */
+export type SoapboxPaymentQuote = {
+  chain_id: number;
+  token: string;
+  escrow: string;
+  key: string;
+  buyer: string;
+  operator: string;
+  amount_microusdc: number;
+  expires: number;
+};
+export type SoapboxMode =
+  | { kind: "paid"; max_cost_credits: number }
+  | { kind: "paid_usdc"; max_cost_microusdc: number; operator: string }
+  | { kind: "private"; pool_id: string }
+  | { kind: "collective"; project_id: string };
+
+export type SoapboxJob = {
+  payment?: SoapboxPaymentQuote | null;
+  id: string;
+  owner: string;
+  status: string;
+  attempts: number;
+  spec: {
+    mode: SoapboxMode;
+    workload: {
+      kind: "sha256" | "embeddings";
+      texts: string[];
+      model?: string;
+      model_digest?: string;
+    };
+  };
+  result: unknown;
+  receipt: unknown;
+  error: string | null;
+};
+
+export type SoapboxRuntime = {
+  model: string;
+  model_digest: string;
+  version: string;
+  model_bytes: number;
+  gpu_bytes: number;
+  observed_at: number;
+};
+
+export type SoapboxGpu = {
+  name: string;
+  uuid: string;
+  driver: string;
+  memory_total_mib: number;
+  memory_free_mib: number;
+  utilization_pct: number;
+  temperature_c: number;
+};
+
+export type SoapboxWalletStatus = {
+  network: "base-sepolia";
+  chain_id: 84532;
+  address: string | null;
+  balance_usdc: string | null;
+  per_transaction_usdc: number;
+  daily_limit_usdc: number;
+  error?: string;
+};
+
+export type SoapboxStatus = {
+  enabled: boolean;
+  api_version?: number;
+  settlement?: string;
+  principal?: { id: string; roles: string[]; pools: string[]; projects: string[] };
+  account?: { available_credits: number; reserved_credits: number; currency: string };
+  payment_account?: { chain_id: number; address: string | null };
+  nodes?: Array<{
+    id: string;
+    online: boolean;
+    operator_paused: boolean;
+    offer: {
+      cpu_threads: number;
+      memory_mib: number;
+      gpu_observed: boolean;
+      modes: string[];
+      paused: boolean;
+      models?: string[];
+      pools?: string[];
+      projects?: string[];
+      runtime?: SoapboxRuntime | null;
+      hardware?: SoapboxGpu[];
+      gpu_unavailable_reason?: string | null;
+      isolation?: string | null;
+    };
+  }>;
+  jobs?: SoapboxJob[];
+};
+
+export class SoapboxClient {
+  private readonly base: URL;
+
+  constructor(
+    url: string,
+    private readonly token: string,
+  ) {
+    this.base = new URL(url);
+    const local = ["127.0.0.1", "localhost", "[::1]"].includes(this.base.hostname);
+    if (
+      (this.base.protocol !== "https:" && !(this.base.protocol === "http:" && local)) ||
+      this.base.username ||
+      this.base.password ||
+      this.base.search ||
+      this.base.hash ||
+      this.base.pathname !== "/"
+    ) {
+      throw new Error("Soapbox requires a root HTTPS URL, or HTTP on loopback");
+    }
+    if (token.length < 32) throw new Error("Soapbox token must contain at least 32 characters");
+  }
+
+  async request<T>(
+    method: "GET" | "POST",
+    path: string,
+    body?: unknown,
+    timeoutMs = 10_000,
+  ): Promise<T> {
+    if (!/^\/v1\/[a-zA-Z0-9/_-]+$/.test(path)) throw new Error("Invalid Soapbox API path");
+    const data = body === undefined ? undefined : JSON.stringify(body);
+    if (data && Buffer.byteLength(data) > 2 * 1024 * 1024)
+      throw new Error("Soapbox request too large");
+    const options: RequestInit = {
+      headers: { Authorization: `Bearer ${this.token}`, "Content-Type": "application/json" },
+      redirect: "error",
+      signal: AbortSignal.timeout(timeoutMs),
+    };
+    if (method === "GET" && data !== undefined) throw new Error("GET requests cannot have a body");
+    const response = await fetch(
+      new URL(path, this.base),
+      method === "GET" ? { ...options, method: "GET" } : { ...options, method: "POST", body: data },
+    );
+    const reader = response.body?.getReader();
+    if (!reader) throw new Error("Empty Soapbox response");
+    const chunks: Uint8Array[] = [];
+    let size = 0;
+    try {
+      for (;;) {
+        const { value, done } = await reader.read();
+        if (done) break;
+        size += value.byteLength;
+        if (size > 32 * 1024 * 1024) throw new Error("Soapbox response too large");
+        chunks.push(value);
+      }
+    } finally {
+      await reader.cancel();
+    }
+    const result: unknown = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+    if (!response.ok) {
+      const message =
+        result &&
+        typeof result === "object" &&
+        "error" in result &&
+        typeof result.error === "string"
+          ? result.error.slice(0, 300)
+          : `HTTP ${response.status}`;
+      throw new Error(`Soapbox: ${message}`);
+    }
+    return result as T;
+  }
+
+  async status(timeoutMs = 10_000): Promise<SoapboxStatus> {
+    const status = await this.request<SoapboxStatus>("GET", "/v1/status", undefined, timeoutMs);
+    if (status.api_version !== 1) throw new Error("Unsupported Soapbox API version");
+    return { ...status, enabled: true };
+  }
+}
+
+export function soapboxClientFromEnv(env: NodeJS.ProcessEnv = process.env): SoapboxClient | null {
+  if (env.BITTERBOT_SOAPBOX_ENABLED !== "1") return null;
+  const token = env.BITTERBOT_SOAPBOX_TOKEN;
+  if (!token) throw new Error("BITTERBOT_SOAPBOX_TOKEN is required");
+  return new SoapboxClient(env.BITTERBOT_SOAPBOX_URL ?? "http://127.0.0.1:8787", token);
+}
