+++ b/scripts/soapbox-desktop-pilot.ps1
@@ -0,0 +1,62 @@
+[CmdletBinding()]
+param([ValidateSet('Start','Stop','Status')][string]$Action = 'Start', [switch]$NoOpen)
+$ErrorActionPreference = 'Stop'
+$integratedMarker = '\\wsl.localhost\Ubuntu\home\vicmg\.bitterbot\compute\active.json'
+if (Test-Path -LiteralPath $integratedMarker) {
+    Write-Host 'Compute is managed by your main Bitterbot app at http://127.0.0.1:19001/. Open Compute in its sidebar.'
+    if ($Action -eq 'Stop') {
+        Write-Host 'Use Pause in the Compute operator panel to stop accepting work.'
+    } elseif ($Action -eq 'Start' -and !$NoOpen) {
+        Start-Process 'http://127.0.0.1:19001/'
+    }
+    return
+}
+if ($Action -ne 'Stop') {
+    try {
+        $pilotReadyResponse = Invoke-WebRequest 'http://127.0.0.1:19031/' -UseBasicParsing -TimeoutSec 3
+        if ($pilotReadyResponse.StatusCode -eq 200 -and $pilotReadyResponse.Content -match '<title>Bitterbot</title>') {
+            Write-Host 'Bitterbot Soapbox is running at http://127.0.0.1:19031 (Base Sepolia testnet).'
+            if ($Action -eq 'Start' -and !$NoOpen) { Start-Process 'http://127.0.0.1:19031/' }
+            return
+        }
+    } catch { <# Continue with service startup or status inspection. #> }
+}
+$pilotRoot = Split-Path -Parent $PSScriptRoot
+for ($attempt = 0; $attempt -lt 3; $attempt++) {
+    $linuxRoot = (& wsl -d Ubuntu --exec wslpath -a $pilotRoot).Trim()
+    if ($LASTEXITCODE -eq 0) { break }
+    Start-Sleep -Seconds 2
+}
+if ($LASTEXITCODE -ne 0) { throw 'Could not connect to WSL Ubuntu. Retry the launcher; the main gateway has not been changed.' }
+if ($Action -eq 'Start') {
+    & wsl -d Ubuntu --exec sh -c 'docker info >/dev/null 2>&1'
+    if ($LASTEXITCODE -ne 0) {
+        $engineScript = "$linuxRoot/../soapbox/scripts/start-container-engine.sh"
+        & wsl -d Ubuntu -u root --exec sh -c 'nohup bash "$1" >/tmp/soapbox-container-engine.log 2>&1 </dev/null &' soapbox-engine $engineScript
+        for ($attempt = 0; $attempt -lt 20; $attempt++) {
+            Start-Sleep -Seconds 1
+            & wsl -d Ubuntu --exec sh -c 'docker info >/dev/null 2>&1'
+            if ($LASTEXITCODE -eq 0) { break }
+        }
+        if ($LASTEXITCODE -ne 0) { throw 'The isolated Docker engine did not become ready.' }
+    }
+}
+if ($Action -eq 'Start') {
+    & wsl -d Ubuntu --exec bash "$linuxRoot/scripts/soapbox-desktop-pilot.sh" check
+    if ($LASTEXITCODE -ne 0) {
+        Start-Process -FilePath 'wsl.exe' -WindowStyle Hidden -ArgumentList @('-d','Ubuntu','--exec','bash',"$linuxRoot/scripts/soapbox-desktop-pilot.sh",'run')
+        Write-Host 'Starting Soapbox at http://127.0.0.1:19031. Initial startup can take a few minutes.'
+    } else { Write-Host 'Soapbox is already running at http://127.0.0.1:19031.' }
+} else {
+    & wsl -d Ubuntu --exec bash "$linuxRoot/scripts/soapbox-desktop-pilot.sh" $Action.ToLowerInvariant()
+    if ($LASTEXITCODE -ne 0) { throw 'Pilot command failed. See ~/.bitterbot-soapbox-pilot/pilot.log in WSL.' }
+}
+if ($Action -eq 'Start' -and !$NoOpen) {
+    for ($attempt = 0; $attempt -lt 180; $attempt++) {
+        try {
+            $response = Invoke-WebRequest 'http://127.0.0.1:19031/' -UseBasicParsing -TimeoutSec 3
+            if ($response.StatusCode -eq 200) { Start-Process 'http://127.0.0.1:19031/'; return }
+        } catch { Start-Sleep -Seconds 3 }
+    }
+    throw 'The pilot is still starting. Check Status and the WSL pilot.log.'
+}
diff --git a/scripts/soapbox-desktop-pilot.sh b/scripts/soapbox-desktop-pilot.sh
new file mode 100644
index 0000000..0a9f458
--- /dev/null
+++ b/scripts/soapbox-desktop-pilot.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
+STATE="${SOAPBOX_PILOT_STATE:-$HOME/.bitterbot-soapbox-pilot}"
+SCRIPT="$ROOT/scripts/soapbox-desktop-pilot.ts"
+if ! command -v node >/dev/null; then
+  export NVM_DIR="$HOME/.nvm"
+  # shellcheck disable=SC1091
+  source "$NVM_DIR/nvm.sh"
+fi
+mkdir -p "$STATE"
+chmod 700 "$STATE"
+pid=""
+if [[ -f "$STATE/launcher.pid" ]]; then pid=$(cat "$STATE/launcher.pid"); fi
+running() {
+  [[ "$pid" =~ ^[0-9]+$ ]] && [[ -r "/proc/$pid/cmdline" ]] && grep -Fq "$SCRIPT" "/proc/$pid/cmdline"
+}
+case "${1:-start}" in
+  run)
+    cd "$ROOT"
+    exec node --env-file="$HOME/.bitterbot/.env" --import tsx "$SCRIPT" >>"$STATE/pilot.log" 2>&1
+    ;;
+  check) running ;;
+  start)
+    if running; then echo 'Pilot is already running: http://127.0.0.1:19031'; exit 0; fi
+    docker info >/dev/null 2>&1 || { echo 'Docker is unavailable; start the isolated container engine first.' >&2; exit 1; }
+    cd "$ROOT"
+    nohup setsid node --env-file="$HOME/.bitterbot/.env" --import tsx "$SCRIPT" >>"$STATE/pilot.log" 2>&1 < /dev/null &
+    echo 'Starting the Soapbox desktop pilot at http://127.0.0.1:19031 (first start can take a few minutes).'
+    ;;
+  stop)
+    if running; then kill -TERM "$pid"; echo 'Pilot shutdown requested; saved jobs and wallet state are retained.'; else echo 'Pilot is stopped.'; fi
+    ;;
+  status)
+    if running; then echo 'Pilot process is running.'; else echo 'Pilot process is stopped.'; fi
+    [[ ! -f "$STATE/process.json" ]] || cat "$STATE/process.json"
+    ;;
+  *) echo 'Usage: soapbox-desktop-pilot.sh start|stop|status' >&2; exit 2 ;;
+esac
diff --git a/scripts/soapbox-desktop-pilot.ts b/scripts/soapbox-desktop-pilot.ts
new file mode 100644
index 0000000..accf951
--- /dev/null
+++ b/scripts/soapbox-desktop-pilot.ts
@@ -0,0 +1,375 @@
+/** Persistent, loopback-only Compute UI with separate Base Sepolia wallet state. */
+import assert from "node:assert/strict";
+import { spawn, type ChildProcess } from "node:child_process";
+import { randomBytes } from "node:crypto";
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { homedir } from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import lockfile from "proper-lockfile";
+
+const root = path.resolve(import.meta.dirname, "..");
+const repo = process.env.SOAPBOX_REPO ?? path.resolve(root, "../soapbox");
+const directory =
+  process.env.SOAPBOX_PILOT_STATE ?? path.join(homedir(), ".bitterbot-soapbox-pilot");
+const binary = process.env.SOAPBOX_BINARY ?? path.join(repo, ".local/bin/soapbox-linux");
+const port = 19031;
+const servicesOnly = process.argv.includes("--services-only");
+const appUrl = `http://127.0.0.1:${servicesOnly ? 19001 : port}`;
+const coordinator = "http://127.0.0.1:8787";
+assert.equal(process.platform, "linux", "Run this pilot in Linux/WSL");
+await mkdir(directory, { recursive: true, mode: 0o700 });
+const release = await lockfile.lock(directory, { retries: 0 });
+await writeFile(path.join(directory, "launcher.pid"), String(process.pid), { mode: 0o600 });
+const json = async (file: string) => JSON.parse(await readFile(file, "utf8"));
+const save = (file: string, data: unknown) =>
+  writeFile(path.join(directory, file), JSON.stringify(data, null, 2), { mode: 0o600 });
+const live = await json(path.join(homedir(), ".bitterbot/bitterbot.json"));
+process.env.CDP_API_KEY_ID ??= live.tools?.wallet?.cdpApiKeyId;
+process.env.CDP_API_KEY_SECRET ??= live.tools?.wallet?.cdpApiKeySecret;
+assert.ok(
+  process.env.CDP_API_KEY_ID && process.env.CDP_API_KEY_SECRET && process.env.CDP_WALLET_SECRET,
+  "The existing CDP environment is required; never put keys in this script",
+);
+const evidence = await json(path.join(repo, "docs/evidence/phase2-base-sepolia.json"));
+const payments = {
+  ...evidence.chain,
+  rpc_url: process.env.SOAPBOX_PILOT_RPC_URL ?? "https://base-sepolia-rpc.publicnode.com",
+};
+assert.equal(payments.chain_id, 84532);
+const accounts = await json(path.join(repo, ".local/testnet-accounts.json"));
+assert.equal(accounts.buyer.toLowerCase(), payments.wallets.buyer.toLowerCase());
+assert.equal(accounts.operator.toLowerCase(), payments.wallets.worker.toLowerCase());
+let credentials: { gateway: string; buyer: string; worker: string };
+try {
+  credentials = await json(path.join(directory, "credentials.json"));
+} catch (error) {
+  if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+  credentials = Object.fromEntries(
+    ["gateway", "buyer", "worker"].map((key) => [key, randomBytes(32).toString("hex")]),
+  ) as typeof credentials;
+  await save("credentials.json", credentials);
+}
+for (const value of Object.values(credentials)) assert.match(value, /^[a-f0-9]{64}$/);
+const admissions: {
+  id: string;
+  role: "buyer" | "operator";
+  address: string;
+  token: string;
+  pools: string[];
+  projects: string[];
+}[] = await json(path.join(directory, "admissions.json")).catch((error: NodeJS.ErrnoException) => {
+  if (error.code !== "ENOENT") throw error;
+  return [];
+});
+const ids = new Set(["buyer", "worker"]);
+const tokens = new Set([credentials.buyer, credentials.worker]);
+for (const entry of admissions) {
+  assert.match(entry.id, /^[a-zA-Z0-9_-]{1,128}$/);
+  assert.ok(!ids.has(entry.id) && !tokens.has(entry.token), "Duplicate enrollment identity");
+  assert.ok(["buyer", "operator"].includes(entry.role));
+  assert.match(entry.token, /^[a-f0-9]{64}$/);
+  assert.match(entry.address, /^0x[\da-f]{40}$/i);
+  ids.add(entry.id);
+  tokens.add(entry.token);
+  payments.wallets[entry.id] = entry.address;
+}
+const worker = await json(path.join(repo, ".local/worker-isolated.json"));
+assert.ok(worker.sandbox && !worker.allow_unsafe_host, "An isolated worker is required");
+await save("worker.json", {
+  ...worker,
+  pools: ["circle"],
+  projects: ["science"],
+  pause_file: path.join(directory, "PAUSE"),
+});
+await save("coordinator.json", {
+  payments,
+  principals: [
+    ...admissions.map((entry, i) => ({
+      id: entry.id,
+      token_env: `SOAPBOX_ENROLLED_${i}`,
+      roles: [entry.role === "buyer" ? "submitter" : "worker"],
+      pools: entry.pools,
+      projects: entry.projects,
+    })),
+    {
+      id: "buyer",
+      token_env: "BITTERBOT_SOAPBOX_TOKEN",
+      roles: ["admin", "submitter"],
+      pools: ["circle"],
+      projects: ["science"],
+    },
+    {
+      id: "worker",
+      token_env: "SOAPBOX_WORKER_TOKEN",
+      roles: ["worker"],
+      pools: ["circle"],
+      projects: ["science"],
+    },
+  ],
+});
+Object.assign(process.env, {
+  BITTERBOT_HOME: directory,
+  BITTERBOT_STATE_DIR: path.join(directory, "gateway"),
+  BITTERBOT_CONFIG_PATH: path.join(directory, "gateway.json"),
+  BITTERBOT_GATEWAY_PORT: String(port),
+  BITTERBOT_GATEWAY_TOKEN: credentials.gateway,
+  BITTERBOT_TASKS_DB: path.join(directory, "tasks.sqlite"),
+  BITTERBOT_TASKS_COMPLETION_NOTIFY: "0",
+  BITTERBOT_TASKS_HORMONAL_GATE: "0",
+  BITTERBOT_EVENT_JOURNAL: "0",
+  BITTERBOT_CHECKPOINTS: "0",
+  VITEST: "1",
+  BITTERBOT_TEST_MINIMAL_GATEWAY: "1",
+  BITTERBOT_SOAPBOX_ENABLED: "1",
+  BITTERBOT_SOAPBOX_URL: coordinator,
+  BITTERBOT_SOAPBOX_TOKEN: credentials.buyer,
+  BITTERBOT_SOAPBOX_ESCROW: payments.escrow,
+  BITTERBOT_SOAPBOX_ESCROW_CODE_SHA256: payments.escrow_code_sha256,
+  BITTERBOT_SOAPBOX_RPC_URL: payments.rpc_url,
+  RPC_URL: payments.rpc_url,
+  NETWORK_ID: "base-sepolia",
+});
+// This process owns its services; the gateway must not launch duplicate children.
+delete process.env.BITTERBOT_SOAPBOX_CONFIG;
+delete process.env.BITTERBOT_SOAPBOX_WORKER_CONFIG;
+await save("gateway.json", {
+  tools: {
+    wallet: {
+      enabled: true,
+      network: "base-sepolia",
+      walletStorePath: path.join(directory, "wallet"),
+      perTransactionCapUsd: 0.1,
+      dailySpendLimitUsd: 1,
+    },
+  },
+  gateway: {
+    mode: "local",
+    port,
+    auth: { mode: "token", token: credentials.gateway },
+    controlUi: { enabled: true, root: path.join(root, "desktop/dist-renderer") },
+  },
+  agents: {
+    defaults: { workspace: path.join(directory, "workspace"), memorySearch: { enabled: false } },
+  },
+});
+await save("process.json", {
+  pid: process.pid,
+  url: appUrl,
+  state: "starting",
+  started_at: new Date().toISOString(),
+});
+
+let stopping = false;
+const children = new Set<ChildProcess>();
+const timers = new Set<ReturnType<typeof setTimeout>>();
+const childEnv = {
+  PATH: process.env.PATH,
+  HOME: homedir(),
+  BITTERBOT_SOAPBOX_TOKEN: credentials.buyer,
+  SOAPBOX_WORKER_TOKEN: credentials.worker,
+  ...Object.fromEntries(admissions.map((entry, i) => [`SOAPBOX_ENROLLED_${i}`, entry.token])),
+};
+function supervise(
+  name: string,
+  args: string[],
+  command = binary,
+  env: NodeJS.ProcessEnv = childEnv,
+) {
+  if (stopping) return;
+  const child = spawn(command, args, { env, stdio: ["ignore", "inherit", "inherit"] });
+  children.add(child);
+  child.on("error", (error) => console.error(`${name}: ${error.message}`));
+  child.on("exit", (code, signal) => {
+    children.delete(child);
+    if (stopping) return;
+    console.error(`${name} exited (${code ?? signal}); restarting in 5 seconds`);
+    const timer = setTimeout(() => {
+      timers.delete(timer);
+      supervise(name, args, command, env);
+    }, 5000);
+    timers.add(timer);
+  });
+}
+let relayTask: Promise<void> | undefined;
+let stopResolve: () => void;
+const stopped = new Promise<void>((resolve) => {
+  stopResolve = resolve;
+});
+for (const signal of ["SIGINT", "SIGTERM"] as const)
+  process.once(signal, () => {
+    stopping = true;
+    stopResolve();
+  });
+try {
+  console.log("Loading the testnet wallet SDK and settlement verifier...");
+  const { CdpClient } = await import("@coinbase/cdp-sdk");
+  const cdp = new CdpClient({
+    apiKeyId: process.env.CDP_API_KEY_ID,
+    apiKeySecret: process.env.CDP_API_KEY_SECRET,
+    walletSecret: process.env.CDP_WALLET_SECRET,
+  });
+  const { createRelay } = (await import(
+    pathToFileURL(path.join(repo, "settlement/relay.mjs")).href
+  )) as {
+    createRelay: (options: {
+      config: typeof payments;
+      url: string;
+      token: string;
+      signer: string;
+      sendTransaction: (tx: {
+        to: `0x${string}`;
+        data: `0x${string}`;
+        value: bigint;
+      }) => Promise<string>;
+      onTransaction: (record: unknown) => void;
+    }) => Promise<() => Promise<void>>;
+  };
+  const relayOptions = {
+    config: payments,
+    url: coordinator,
+    token: credentials.buyer,
+    signer: accounts.settler,
+    sendTransaction: async (transaction: {
+      to: `0x${string}`;
+      data: `0x${string}`;
+      value: bigint;
+    }) =>
+      (
+        await cdp.evm.sendTransaction({
+          address: accounts.settler,
+          network: "base-sepolia",
+          transaction,
+        })
+      ).transactionHash,
+    onTransaction: (record: unknown) =>
+      console.log("Settlement transaction", JSON.stringify(record)),
+  };
+  let tick: (() => Promise<void>) | undefined;
+  for (let attempt = 0; attempt < 5 && !stopping; attempt++) {
+    try {
+      tick = await createRelay(relayOptions);
+      break;
+    } catch (error) {
+      if (attempt === 4) throw error;
+      console.error("Escrow verification unavailable; retrying in 10 seconds.");
+      await Promise.race([stopped, new Promise((resolve) => setTimeout(resolve, 10000))]);
+    }
+  }
+  assert.ok(tick, "Escrow verification did not finish");
+  console.log("Base Sepolia escrow verified; starting isolated compute services.");
+  supervise("coordinator", [
+    "serve",
+    "--config",
+    path.join(directory, "coordinator.json"),
+    "--db",
+    path.join(directory, "state.sqlite"),
+    "--bind",
+    "127.0.0.1:8787",
+  ]);
+  let ready = false;
+  for (let attempt = 0; attempt < 40 && !stopping; attempt++) {
+    try {
+      const response = await fetch(`${coordinator}/v1/status`, {
+        headers: { Authorization: `Bearer ${credentials.buyer}` },
+        signal: AbortSignal.timeout(1000),
+      });
+      if (response.ok) {
+        ready = true;
+        break;
+      }
+    } catch {
+      /* Wait for the owned coordinator to bind. */
+    }
+    await new Promise((resolve) => setTimeout(resolve, 250));
+  }
+  assert.ok(ready, "Coordinator did not become ready (check port 8787)");
+  relayTask = (async () => {
+    while (!stopping) {
+      try {
+        await tick!();
+      } catch (error) {
+        console.error("Settlement retry:", error instanceof Error ? error.message : String(error));
+      }
+      await Promise.race([stopped, new Promise((resolve) => setTimeout(resolve, 3000))]);
+    }
+  })();
+  // Use the production bundle so the wallet sidebar does not cold-load AgentKit's
+  // unrelated integrations over WSL's slow mounted filesystem.
+  if (!servicesOnly)
+    supervise(
+      "gateway",
+      [
+        path.join(root, "dist/entry.js"),
+        "gateway",
+        "run",
+        "--port",
+        String(port),
+        "--bind",
+        "loopback",
+      ],
+      process.execPath,
+      process.env,
+    );
+  let uiReady = servicesOnly;
+  for (let attempt = 0; !uiReady && attempt < 300 && !stopping; attempt++) {
+    try {
+      const response = await fetch(`http://127.0.0.1:${port}/`, {
+        signal: AbortSignal.timeout(1000),
+      });
+      if (response.ok) {
+        uiReady = true;
+        break;
+      }
+    } catch {
+      /* Wait for the built gateway and renderer. */
+    }
+    await new Promise((resolve) => setTimeout(resolve, 1000));
+  }
+  assert.ok(uiReady || stopping, "Desktop gateway did not become ready; inspect pilot.log");
+  if (!stopping) {
+    if (process.env.SOAPBOX_LOCAL_WORKER !== "0")
+      supervise("worker", [
+        "worker",
+        "--config",
+        path.join(directory, "worker.json"),
+        "--coordinator",
+        coordinator,
+      ]);
+    await save("process.json", {
+      pid: process.pid,
+      url: appUrl,
+      services_only: servicesOnly,
+      state: "ready",
+      chain_id: 84532,
+      buyer: accounts.buyer,
+      operator: accounts.operator,
+    });
+    console.log(`Soapbox desktop ready: ${appUrl} — Compute`);
+  }
+  await stopped;
+} catch (error) {
+  process.exitCode = 1;
+  console.error(error instanceof Error ? error.message : String(error));
+} finally {
+  stopping = true;
+  stopResolve!();
+  for (const timer of timers) clearTimeout(timer);
+  for (const child of children) child.kill("SIGTERM");
+  await Promise.race([
+    Promise.all(
+      [...children].map((child) => new Promise((resolve) => child.once("exit", resolve))),
+    ),
+    new Promise((resolve) => setTimeout(resolve, 5000)),
+  ]);
+  for (const child of children)
+    if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
+  await Promise.race([relayTask, new Promise((resolve) => setTimeout(resolve, 5000))]);
+  await save("process.json", {
+    pid: process.pid,
+    state: "stopped",
+    url: appUrl,
+  });
+  await release();
+  process.exit(process.exitCode ?? 0);
+}
diff --git a/scripts/soapbox-gpu-pilot.ps1 b/scripts/soapbox-gpu-pilot.ps1
new file mode 100644
index 0000000..1aaa77c
--- /dev/null
+++ b/scripts/soapbox-gpu-pilot.ps1
@@ -0,0 +1,47 @@
+[CmdletBinding()]
+param([switch]$TestOnly)
+$ErrorActionPreference = 'Stop'
+$repo = Split-Path -Parent $PSScriptRoot
+$soapbox = Join-Path (Split-Path -Parent $repo) 'soapbox'
+$binary = Join-Path $soapbox '.local/bin/soapbox.exe'
+if (!(Test-Path -LiteralPath $binary)) { throw 'Build the native Soapbox executable first. See docs/network/soapbox.md.' }
+if (!$TestOnly -and !(Test-Path -LiteralPath (Join-Path $repo 'desktop/dist-renderer/index.html'))) {
+    throw 'Build the desktop renderer first: run the Vite build from desktop/.'
+}
+$keys = @('SOAPBOX_BINARY','SOAPBOX_REPORT','ESBUILD_BINARY_PATH','NODE_PATH')
+$previous = @{}
+foreach ($key in $keys) { $previous[$key] = [Environment]::GetEnvironmentVariable($key,'Process') }
+$owned = $null
+Push-Location $repo
+try {
+    try { $runtime = Invoke-RestMethod 'http://127.0.0.1:11434/api/version' -TimeoutSec 3 } catch { $runtime = $null }
+    if (!$runtime) {
+        & (Join-Path $soapbox 'scripts/setup-gpu.ps1') -KeepRuntime
+        $runtimeId = [int](Get-Content -LiteralPath (Join-Path $soapbox '.local/ollama.pid'))
+        $owned = Get-Process -Id $runtimeId
+        if ($owned.Path -ne (Join-Path $soapbox '.local/ollama/ollama.exe')) { throw 'Unexpected runtime process' }
+    }
+    $env:SOAPBOX_BINARY = $binary
+    $env:SOAPBOX_REPORT = Join-Path $soapbox '.local/gpu-validation.json'
+    # Optional local accommodations for this WSL-installed dependency checkout.
+    $esbuild = Join-Path $soapbox '.local/esbuild/package/esbuild.exe'
+    if (!$env:ESBUILD_BINARY_PATH -and (Test-Path -LiteralPath $esbuild)) { $env:ESBUILD_BINARY_PATH = $esbuild }
+    $redirects = Join-Path $repo 'node_modules/.pnpm/follow-redirects@1.15.11_debug@4.4.3/node_modules'
+    if (Test-Path -LiteralPath $redirects) { $env:NODE_PATH = (@($env:NODE_PATH,$redirects) | Where-Object { $_ }) -join ';' }
+    $arguments = @('--import','tsx','scripts/soapbox-smoke.ts','--gpu')
+    if (!$TestOnly) { $arguments += '--keep' }
+    & node @arguments
+    if ($LASTEXITCODE -ne 0) { throw "GPU pilot failed with exit code $LASTEXITCODE" }
+} finally {
+    if ($owned -and !$owned.HasExited) {
+        $runtimeRoot = [IO.Path]::GetFullPath((Join-Path $soapbox '.local/ollama')) + [IO.Path]::DirectorySeparatorChar
+        Get-CimInstance Win32_Process -Filter "ParentProcessId=$($owned.Id)" | ForEach-Object {
+            if ($_.ExecutablePath -and $_.ExecutablePath.StartsWith($runtimeRoot,[StringComparison]::OrdinalIgnoreCase)) {
+                Stop-Process -Id $_.ProcessId -ErrorAction SilentlyContinue
+            }
+        }
+        Stop-Process -Id $owned.Id -ErrorAction SilentlyContinue
+    }
+    foreach ($key in $keys) { [Environment]::SetEnvironmentVariable($key,$previous[$key],'Process') }
+    Pop-Location
+}
