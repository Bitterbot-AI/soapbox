+++ b/src/gateway/server-methods/soapbox.test.ts
@@ -0,0 +1,102 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { GatewayRequestHandlerOptions } from "./types.js";
+import { createSoapboxHandlers, soapboxHandlers } from "./soapbox.js";
+
+const fake = vi.hoisted(() => ({
+  request: vi.fn(),
+  status: vi.fn(),
+  enabled: true,
+  wallet: vi.fn(),
+  fund: vi.fn(),
+}));
+vi.mock("../../services/soapbox-wallet.js", () => ({
+  createSoapboxWallet: fake.wallet,
+  getSoapboxWalletStatus: vi.fn(),
+}));
+vi.mock("../../infra/soapbox-client.js", () => ({
+  soapboxClientFromEnv: () => (fake.enabled ? fake : null),
+}));
+afterEach(() => {
+  vi.clearAllMocks();
+  fake.enabled = true;
+});
+async function invoke(method: string, params: Record<string, unknown>) {
+  const respond = vi.fn();
+  await soapboxHandlers[method]({ params, respond } as unknown as GatewayRequestHandlerOptions);
+  return respond;
+}
+describe("Soapbox gateway adapter", () => {
+  it("blocks operator wallet access and funding before creating a wallet", async () => {
+    const handlers = createSoapboxHandlers(undefined, { role: "operator", client: fake as never });
+    for (const method of [
+      "soapbox.wallet",
+      "soapbox.payment.fund",
+      "soapbox.submit",
+      "soapbox.cancel",
+    ]) {
+      const respond = vi.fn();
+      await handlers[method]({
+        params: { id: "job-1" },
+        respond,
+      } as unknown as GatewayRequestHandlerOptions);
+      expect(respond.mock.calls[0][0]).toBe(false);
+    }
+    expect(fake.wallet).not.toHaveBeenCalled();
+    expect(fake.fund).not.toHaveBeenCalled();
+    expect(fake.request).not.toHaveBeenCalled();
+  });
+  it("funds through the dedicated wallet while the main wallet remains on Base", async () => {
+    const main = { enabled: true, network: "base" as const, walletStorePath: "/mainnet" };
+    const payment = { chain_id: 84532, amount_microusdc: 2000 };
+    fake.wallet.mockResolvedValue({ fundSoapbox: fake.fund });
+    fake.fund.mockResolvedValue({ status: "funded", txHash: "0xtest" });
+    fake.request
+      .mockResolvedValueOnce({ status: "awaiting_payment", payment })
+      .mockResolvedValueOnce({ status: "queued" });
+    const respond = vi.fn();
+    await createSoapboxHandlers(main)["soapbox.payment.fund"]({
+      params: { id: "job-1" },
+      respond,
+    } as unknown as GatewayRequestHandlerOptions);
+    expect(fake.wallet).toHaveBeenCalledWith(main);
+    expect(fake.fund).toHaveBeenCalledWith(payment);
+    expect(main.network).toBe("base");
+    expect(respond.mock.calls[0][0]).toBe(true);
+  });
+  it("returns a disabled state without connecting", async () => {
+    fake.enabled = false;
+    const respond = await invoke("soapbox.status", {});
+    expect(respond).toHaveBeenCalledWith(true, { enabled: false });
+    expect(fake.request).not.toHaveBeenCalled();
+  });
+  it("forwards the original idempotency key and policy", async () => {
+    const spec = { idempotency_key: "retry-1", mode: { kind: "paid", max_cost_credits: 10 } };
+    fake.request.mockResolvedValue({ id: "job-1" });
+    const respond = await invoke("soapbox.submit", spec);
+    expect(fake.request).toHaveBeenCalledWith("POST", "/v1/jobs", spec);
+    expect(respond).toHaveBeenCalledWith(true, { id: "job-1" });
+  });
+  it("rejects path injection before making an HTTP request", async () => {
+    const respond = await invoke("soapbox.cancel", { id: "../credits" });
+    expect(respond.mock.calls[0][0]).toBe(false);
+    expect(fake.request).not.toHaveBeenCalled();
+  });
+  it("requires explicit boolean worker control", async () => {
+    const respond = await invoke("soapbox.worker.pause", { id: "worker-1", paused: "false" });
+    expect(respond.mock.calls[0][0]).toBe(false);
+    expect(fake.request).not.toHaveBeenCalled();
+  });
+  it("only funds a quote fetched from the coordinator, never client-supplied payment fields", async () => {
+    fake.request.mockResolvedValue({
+      id: "job-1",
+      status: "running",
+      payment: { amount_microusdc: 1 },
+    });
+    const respond = await invoke("soapbox.payment.fund", {
+      id: "job-1",
+      payment: { amount_microusdc: 100000000 },
+    });
+    expect(fake.request).toHaveBeenCalledWith("GET", "/v1/jobs/job-1");
+    expect(respond.mock.calls[0][0]).toBe(false);
+  });
+});
diff --git a/src/gateway/server-methods/soapbox.ts b/src/gateway/server-methods/soapbox.ts
new file mode 100644
index 0000000..d4952ef
--- /dev/null
+++ b/src/gateway/server-methods/soapbox.ts
@@ -0,0 +1,129 @@
+import type { WalletConfig } from "../../config/types.wallet.js";
+import type { GatewayRequestHandlers } from "./types.js";
+import {
+  soapboxClientFromEnv,
+  type SoapboxJob,
+  type SoapboxClient,
+} from "../../infra/soapbox-client.js";
+import { createSoapboxWallet, getSoapboxWalletStatus } from "../../services/soapbox-wallet.js";
+import { ErrorCodes, errorShape } from "../protocol/index.js";
+
+function id(value: unknown): string {
+  if (typeof value !== "string" || !/^[a-zA-Z0-9_-]{1,128}$/.test(value))
+    throw new Error("Invalid Soapbox identifier");
+  return value;
+}
+
+type Route = (params: Record<string, unknown>) => {
+  method: "GET" | "POST";
+  path: string;
+  body?: unknown;
+};
+const routes: Record<string, Route> = {
+  "soapbox.payment.refresh": (params) => ({
+    method: "POST",
+    path: `/v1/jobs/${id(params.id)}/payment`,
+    body: {},
+  }),
+  "soapbox.job": (params) => ({ method: "GET", path: `/v1/jobs/${id(params.id)}` }),
+  "soapbox.jobs": () => ({ method: "GET", path: "/v1/jobs" }),
+  "soapbox.submit": (params) => ({ method: "POST", path: "/v1/jobs", body: params }),
+  "soapbox.cancel": (params) => ({
+    method: "POST",
+    path: `/v1/jobs/${id(params.id)}/cancel`,
+    body: {},
+  }),
+  "soapbox.worker.pause": (params) => {
+    if (typeof params.paused !== "boolean") throw new Error("paused must be a boolean");
+    return {
+      method: "POST",
+      path: `/v1/workers/${id(params.id)}/pause`,
+      body: { paused: params.paused },
+    };
+  },
+  "soapbox.artifact.put": (params) => ({ method: "POST", path: "/v1/artifacts", body: params }),
+  "soapbox.artifact.get": (params) => ({ method: "GET", path: `/v1/artifacts/${id(params.id)}` }),
+};
+
+export function createSoapboxHandlers(
+  mainWallet?: WalletConfig,
+  options?: {
+    client: SoapboxClient;
+    role: "buyer" | "operator";
+  },
+): GatewayRequestHandlers {
+  const getClient = () => options?.client ?? soapboxClientFromEnv();
+  const requireBuyer = () => {
+    if (options?.role === "operator")
+      throw new Error("Operator setup cannot access or spend a buyer wallet");
+  };
+  return {
+    "soapbox.wallet": async ({ respond }) => {
+      try {
+        requireBuyer();
+        if (!getClient()) throw new Error("Soapbox is disabled");
+        respond(true, await getSoapboxWalletStatus());
+      } catch (error) {
+        respond(false, undefined, errorShape(ErrorCodes.UNAVAILABLE, String(error)));
+      }
+    },
+    "soapbox.payment.fund": async ({ params, respond }) => {
+      try {
+        requireBuyer();
+        const client = getClient();
+        if (!client) throw new Error("Soapbox is disabled");
+        const job = await client.request<SoapboxJob>("GET", `/v1/jobs/${id(params.id)}`);
+        if (!job.payment || job.status !== "awaiting_payment")
+          throw new Error("Job is not awaiting USDC funding");
+        const wallet = await createSoapboxWallet(mainWallet);
+        const funding = await wallet.fundSoapbox!(job.payment);
+        const updated = await client.request<SoapboxJob>(
+          "POST",
+          `/v1/jobs/${id(params.id)}/payment`,
+          {},
+        );
+        respond(true, { funding, job: updated });
+      } catch (error) {
+        respond(false, undefined, errorShape(ErrorCodes.INVALID_REQUEST, String(error)));
+      }
+    },
+    "soapbox.status": async ({ respond }) => {
+      try {
+        const client = getClient();
+        respond(true, client ? await client.status() : { enabled: false });
+      } catch (error) {
+        respond(false, undefined, errorShape(ErrorCodes.UNAVAILABLE, String(error)));
+      }
+    },
+    ...Object.fromEntries(
+      Object.entries(routes).map(
+        ([method, route]) =>
+          [
+            method,
+            async ({ params, respond }) => {
+              try {
+                if (
+                  [
+                    "soapbox.submit",
+                    "soapbox.cancel",
+                    "soapbox.artifact.put",
+                    "soapbox.artifact.get",
+                  ].includes(method)
+                )
+                  requireBuyer();
+                const client = getClient();
+                if (!client)
+                  throw new Error("Soapbox is disabled; configure it on the gateway first");
+                const request = route(params);
+                respond(true, await client.request(request.method, request.path, request.body));
+              } catch (error) {
+                respond(false, undefined, errorShape(ErrorCodes.INVALID_REQUEST, String(error)));
+              }
+            },
+          ] as [string, GatewayRequestHandlers[string]],
+      ),
+    ),
+  };
+}
+
+export const soapboxHandlers = createSoapboxHandlers();
