+"""Stage Compute changes on the supported desktop release without replacing its other features."""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import re
+
+root = Path(__file__).resolve().parent.parent
+base = Path(sys.argv[1]).resolve()
+stage = Path(tempfile.mkdtemp(prefix="soapbox-rc5-source-"))
+git = "/usr/bin/git"
+ancestor_ref = "268c765e84b233312e3924c427dbfba46c5ba57c"
+archive = stage / "source.tar"
+subprocess.run([git, "-C", str(base), "archive", "--format=tar", f"--output={archive}", "HEAD"], check=True)
+subprocess.run(["tar", "-xf", str(archive), "-C", str(stage)], check=True)
+archive.unlink()
+
+# Three-way integration retains changes unique to the installed release.
+for name in ["src/gateway/server-startup.ts", "src/gateway/server.impl.ts", "src/gateway/server-close.ts",
+             "src/gateway/server-methods/types.ts", "src/circles/circle-p2p-transport.ts", "src/infra/orchestrator-bridge.ts"]:
+    ancestor = stage / "ancestor.tmp"
+    ancestor.write_bytes(subprocess.check_output([git, "-C", str(root), "show", f"{ancestor_ref}:{name}"]))
+    result = subprocess.run([git, "merge-file", str(stage/name), str(ancestor), str(root/name)])
+    if result.returncode and name == "src/gateway/server-startup.ts":
+        merged = (stage/name).read_text()
+        pattern = r'<<<<<<<[^\n]*\n(.*?)=======\n(.*?)>>>>>>>[^\n]*\n'
+        conflicts = list(re.finditer(pattern, merged, re.S))
+        if len(conflicts) == 1 and 'startMonitorEngine' in conflicts[0][1] and 'computeMesh,' in conflicts[0][2]:
+            keep_monitor = conflicts[0][1].split('  return {')[0]
+            (stage/name).write_text(merged[:conflicts[0].start()] + keep_monitor + conflicts[0][2] + merged[conflicts[0].end():])
+            result.returncode = 0
+    if result.returncode:
+        raise RuntimeError(f"Release integration conflict: {stage/name}")
+    ancestor.unlink()
+
+for folder in ["src/compute", "desktop/renderer/src/components/compute", "extensions/soapbox-compute"]:
+    shutil.copytree(root/folder, stage/folder, dirs_exist_ok=True)
+for folder in ["src/infra", "src/services", "src/gateway/server-methods"]:
+    for file in (root/folder).glob("soapbox*.ts"):
+        shutil.copyfile(file, stage/folder/file.name)
+for name in ["src/gateway/server-methods/compute-mesh.ts", "scripts/build-gateway-entry.mjs"]:
+    shutil.copyfile(root/name, stage/name)
+
+def replace(name, before, after):
+    file = stage/name
+    text = file.read_text()
+    assert text.count(before) == 1, (name, before)
+    file.write_text(text.replace(before, after))
+
+methods = 'src/gateway/server-methods.ts'
+replace(methods, 'const ADMIN_METHOD_PREFIXES = ["exec.approvals."];', 'const ADMIN_METHOD_PREFIXES = ["exec.approvals.", "soapbox.setup.", "soapbox.mesh."];')
+replace(methods, 'const READ_METHODS = new Set([', 'const READ_METHODS = new Set(["soapbox.wallet", "soapbox.status", "soapbox.jobs", "soapbox.job", "soapbox.artifact.get",')
+replace(methods, 'const WRITE_METHODS = new Set([', 'const WRITE_METHODS = new Set(["soapbox.submit", "soapbox.cancel", "soapbox.artifact.put",')
+replace(methods, 'import { configHandlers }', 'import { computeMeshHandlers } from "./server-methods/compute-mesh.js";\nimport { configHandlers }')
+replace(methods, '  ...configHandlers,', '  ...configHandlers,\n  ...computeMeshHandlers,')
+source = (root/'src/gateway/server-methods-list.ts').read_text()
+prefix = source[source.index('  "soapbox.setup.status",'):source.index('  "health",')]
+replace('src/gateway/server-methods-list.ts', 'const BASE_METHODS = [', 'const BASE_METHODS = [\n'+prefix)
+replace('desktop/renderer/src/components/layout/AppShell.tsx', 'const VIEW_MAP:', 'import { ComputeView } from "../compute/ComputeView";\nconst VIEW_MAP:')
+replace('desktop/renderer/src/components/layout/AppShell.tsx', '  chat: () => <ChatView />,', '  compute: () => <ComputeView />,\n  chat: () => <ChatView />,')
+replace('desktop/renderer/src/nav-manifest.ts', '  // ── Advanced ──', '  { id: "compute", label: "Compute", icon: Server, group: "main" },\n  // ── Advanced ──')
+# Only insert the Compute panel into the installed P2P dashboard; retain other release UI.
+local = (root/'desktop/renderer/src/components/p2p/P2pDashboard.tsx').read_text()
+target = stage/'desktop/renderer/src/components/p2p/P2pDashboard.tsx'
+text = target.read_text()
+text = 'import { MeshPanel } from "../compute/MeshPanel";\n'+text
+# Match the insertion context from the source change instead of copying the older dashboard.
+diff = subprocess.check_output([git, '-C', str(root), 'diff', '--unified=3', ancestor_ref, '--', 'desktop/renderer/src/components/p2p/P2pDashboard.tsx'], text=True)
+lines = diff.splitlines()
+for i,line in enumerate(lines):
+    if line.startswith('+') and '<MeshPanel' in line:
+        anchor = '\n'.join(l[1:] for l in lines[i+1:i+4] if l.startswith(' '))
+        assert anchor and text.count(anchor)==1, 'P2P panel insertion anchor changed'
+        text=text.replace(anchor,line[1:]+'\n'+anchor)
+target.write_text(text)
+for name in ['node_modules', 'desktop/node_modules']:
+    os.symlink(base/name,stage/name,target_is_directory=True)
+output = root/'dist/soapbox-integration'
+output.mkdir(parents=True,exist_ok=True)
+(output/'source-stage.json').write_text(json.dumps({'stage':str(stage),'base':str(base)}))
+print(stage,flush=True)
diff --git a/scripts/check-payment-paths.mjs b/scripts/check-payment-paths.mjs
new file mode 100644
index 00000000..cbea9954
--- /dev/null
+++ b/scripts/check-payment-paths.mjs
@@ -0,0 +1,105 @@
+#!/usr/bin/env node
+/**
+ * PLAN-47 Phase 0 (invariant I4): freeze the value-moving surface.
+ *
+ * Every code path that actually moves value must stay inside a known, small set
+ * of files, so that when the AP2 mandate layer (Phase 1) and the Policy Decision
+ * Record enforcement gate (Phase 4) land, routing *all* spend through the gate is
+ * mechanical and a new unguarded payment path cannot sneak in unnoticed. This is
+ * the same freeze-the-surface move PLAN-46 made for `chunks` writes
+ * (scripts/check-chunk-writes.mjs): establish the current legitimate callers as
+ * the allowlist; a NEW caller in any other file fails lint.
+ *
+ * Two value-moving patterns are enforced:
+ *   A. outbound USDC spend   — `.sendUsdc(` / `.payForResource(` method calls
+ *   B. onchain EIP-3009 pull — `functionName: "transferWithAuthorization"`
+ *
+ * When Phase 1/4 land, the allowlist SHRINKS to the gated wrapper — it does not
+ * grow. Adding a file here without routing it through the mandate/enforcement
+ * gate defeats I4; do that only with an explicit PLAN-47 note.
+ */
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import { join } from "node:path";
+
+const ROOT = "src";
+
+// Pattern A: outbound spend method calls. The interface signature and the
+// `async sendUsdc(` definition in wallet-service.ts have no leading dot, so they
+// do not match; only actual `x.sendUsdc(...)` / `x.payForResource(...)` calls do.
+const SPEND_CALL_RE = /\.(sendUsdc|payForResource|fundSoapbox)\s*!?\s*\(/g;
+const SPEND_ALLOW = new Set([
+  "src/agents/tools/wallet-tool.ts", // the gated wallet tool (opt-in + session caps)
+  "src/services/a2a-client.ts", // A2A auto-pay for a 402-gated peer task
+  "src/services/wallet-service.ts", // the service itself (definition + internal use)
+  "src/gateway/server-methods/wallet.ts", // the wallet gateway RPC (pay_for_resource)
+  "src/gateway/server-methods/soapbox.ts", // authenticated admin and exact-quote review
+  "src/services/soapbox-wallet.ts", // Compute quote approval gate and decision record
+  "src/memory/manager.ts", // PLAN-8 revenue/bounty payout dispatch (markPaymentProcessed)
+  // Future: "src/payments/ap2/gate.ts" — the mandate+enforcement wrapper (Phase 1/4).
+]);
+
+// Pattern B: the onchain EIP-3009 capture. Matching the functionName string (not
+// bare mentions) avoids the doc-comment references in settlement.ts / bounty-funding.ts.
+const EIP3009_RE = /functionName:\s*["']transferWithAuthorization["']/g;
+const EIP3009_ALLOW = new Set([
+  "src/commerce/cdp-adapters.ts", // the sole EIP-3009 transferWithAuthorization submitter
+]);
+
+const RAW_CDP_SEND_RE = /\.evm\.sendTransaction\s*\(/g;
+const RAW_CDP_SEND_ALLOW = new Set(["src/services/wallet-service.ts"]);
+
+function walk(dir) {
+  const out = [];
+  for (const e of readdirSync(dir)) {
+    const p = join(dir, e);
+    const st = statSync(p);
+    if (st.isDirectory()) {
+      if (e === "node_modules" || e === "dist") continue;
+      out.push(...walk(p));
+    } else if (p.endsWith(".ts") && !p.endsWith(".test.ts")) {
+      out.push(p);
+    }
+  }
+  return out;
+}
+
+function lineOf(src, index) {
+  return src.slice(0, index).split("\n").length;
+}
+
+const violations = [];
+for (const file of walk(ROOT)) {
+  const norm = file.replaceAll("\\", "/");
+  const src = readFileSync(file, "utf-8");
+
+  if (!SPEND_ALLOW.has(norm)) {
+    for (const m of src.matchAll(SPEND_CALL_RE)) {
+      violations.push(
+        `${norm}:${lineOf(src, m.index)}  value-moving call ${m[0]} — route spend through the PLAN-47 mandate/enforcement gate`,
+      );
+    }
+  }
+  if (!EIP3009_ALLOW.has(norm)) {
+    for (const m of src.matchAll(EIP3009_RE)) {
+      violations.push(
+        `${norm}:${lineOf(src, m.index)}  onchain transferWithAuthorization outside cdp-adapters.ts`,
+      );
+    }
+  }
+  if (!RAW_CDP_SEND_ALLOW.has(norm)) {
+    for (const m of src.matchAll(RAW_CDP_SEND_RE)) {
+      violations.push(
+        `${norm}:${lineOf(src, m.index)} raw CDP transaction outside wallet-service.ts`,
+      );
+    }
+  }
+}
+
+if (violations.length > 0) {
+  console.error("check-payment-paths: unguarded value-moving paths (PLAN-47 I4):");
+  for (const v of violations) console.error("  " + v);
+  process.exit(1);
+}
+console.log(
+  `check-payment-paths: OK (I4 holds; spend confined to ${SPEND_ALLOW.size} files, EIP-3009 capture to ${EIP3009_ALLOW.size})`,
+);
diff --git a/scripts/check-payment-paths.test.mjs b/scripts/check-payment-paths.test.mjs
new file mode 100644
index 00000000..e51536c8
--- /dev/null
+++ b/scripts/check-payment-paths.test.mjs
@@ -0,0 +1,37 @@
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, mkdirSync, writeFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { test } from "node:test";
+
+await test("payment lint catches raw CDP signing and Compute funding outside reviewed entrypoints", () => {
+  const root = mkdtempSync(path.join(tmpdir(), "bitterbot-payment-lint-"));
+  try {
+    mkdirSync(path.join(root, "src"));
+    const file = path.join(root, "src", "unreviewed.ts");
+    for (const source of [
+      "wallet.fundSoapbox!(quote)",
+      "wallet.fundSoapbox(quote)",
+      "cdp.evm.sendTransaction(transaction)",
+    ]) {
+      writeFileSync(file, source);
+      const result = spawnSync(
+        process.execPath,
+        [path.join(import.meta.dirname, "check-payment-paths.mjs")],
+        { cwd: root, encoding: "utf8" },
+      );
+      assert.equal(result.status, 1);
+      assert.match(result.stderr, /unreviewed.ts/);
+    }
+    writeFileSync(file, "wallet.getBalance()");
+    assert.equal(
+      spawnSync(process.execPath, [path.join(import.meta.dirname, "check-payment-paths.mjs")], {
+        cwd: root,
+      }).status,
+      0,
+    );
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
diff --git a/scripts/compute-mesh-e2e.ts b/scripts/compute-mesh-e2e.ts
new file mode 100644
index 00000000..ee6a2302
--- /dev/null
+++ b/scripts/compute-mesh-e2e.ts
@@ -0,0 +1,345 @@
+/** Real localhost libp2p + Rust coordinator + isolated worker acceptance test.
+ * Runs in Linux/WSL. Uses temporary identities; never loads a wallet or public bootstrap.
+ * SOAPBOX_BIN and ORCHESTRATOR_BIN point at the matching development builds.
+ */
+import assert from "node:assert/strict";
+import { spawn, type ChildProcess } from "node:child_process";
+import { randomBytes } from "node:crypto";
+import { createWriteStream } from "node:fs";
+import { mkdtemp, mkdir, writeFile, readFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import type { OrchestratorBridge as BridgeType } from "../src/infra/orchestrator-bridge.js";
+import { ComputeMeshService } from "../src/compute/mesh-service.js";
+import { ComputeMeshStore } from "../src/compute/mesh-store.js";
+import { SoapboxClient } from "../src/infra/soapbox-client.js";
+
+const root = await mkdtemp(path.join(tmpdir(), "compute-mesh-e2e-"));
+process.env.BITTERBOT_STATE_DIR = path.join(root, "gateway");
+process.env.BITTERBOT_CONFIG_PATH = path.join(root, "gateway.json");
+await writeFile(process.env.BITTERBOT_CONFIG_PATH, "{}");
+const { OrchestratorBridge } = await import("../src/infra/orchestrator-bridge.js");
+const { startCircleP2pTransport } = await import("../src/circles/circle-p2p-transport.js");
+const children: ChildProcess[] = [];
+const workers: Array<{ child: ChildProcess; token: string; url: string; config: string }> = [];
+const bridges: BridgeType[] = [];
+const meshes: ComputeMeshService[] = [];
+const transports: Array<{ stop(): void }> = [];
+const base = process.env.MESH_TEST_PORT ? Number(process.env.MESH_TEST_PORT) : 29240;
+const minimalEnv = { PATH: process.env.PATH, HOME: root };
+async function save(file: string, value: unknown) {
+  await writeFile(file, JSON.stringify(value), { mode: 0o600 });
+}
+function launch(bin: string, args: string[], env: NodeJS.ProcessEnv) {
+  const child = spawn(bin, args, { env, stdio: ["ignore", "pipe", "pipe"] });
+  children.push(child);
+  const log = createWriteStream(path.join(root, `child-${children.length}.log`), { mode: 0o600 });
+  child.stdout?.pipe(log, { end: false });
+  child.stderr?.pipe(log, { end: false });
+  child.once("close", () => log.end());
+  let errors = "";
+  child.stderr?.on("data", (b) => {
+    errors = (errors + b.toString()).slice(-2000);
+  });
+  child.on("error", () => {});
+  child.on("exit", (code) => {
+    if (code) process.stderr.write(`Test child exited ${code}: ${errors}\n`);
+  });
+  return child;
+}
+async function until(fn: () => Promise<boolean>, label: string, ms = 90000) {
+  const end = Date.now() + ms;
+  while (Date.now() < end) {
+    if (await fn()) return;
+    await delay(500);
+  }
+  throw Error(`Timed out: ${label}`);
+}
+async function completedBatch(mesh: ComputeMeshService, id: string): Promise<boolean> {
+  const status = mesh.store.batch(id)?.status;
+  assert(
+    !["failed", "cancelled"].includes(status ?? ""),
+    `Batch ${id} ended ${status}; see ${root}`,
+  );
+  return status === "succeeded";
+}
+try {
+  const workerConfig = JSON.parse(
+    await readFile(
+      process.env.SOAPBOX_SANDBOX_CONFIG ?? "/mnt/d/Bitterbot/soapbox/.local/worker-isolated.json",
+      "utf8",
+    ),
+  );
+  assert(
+    workerConfig.sandbox && !workerConfig.allow_unsafe_host,
+    "Isolated worker configuration required",
+  );
+  const backend = [];
+  for (let i = 0; i < 3; i++) {
+    console.log(`Starting isolated test node ${i}`);
+    const dir = path.join(root, String(i));
+    await mkdir(path.join(dir, "keys"), { recursive: true });
+    await writeFile(path.join(dir, "keys/node.key"), randomBytes(32), { mode: 0o600 });
+    let local = null;
+    if (i > 0) {
+      const admin = randomBytes(32).toString("hex"),
+        worker = randomBytes(32).toString("hex");
+      await save(path.join(dir, "coordinator.json"), {
+        principals: [
+          {
+            id: "admin",
+            token_env: "MESH_ADMIN",
+            roles: ["admin", "submitter"],
+            pools: ["circle"],
+            projects: ["science"],
+          },
+          {
+            id: "worker",
+            token_env: "MESH_WORKER",
+            roles: ["worker"],
+            pools: ["circle"],
+            projects: ["science"],
+          },
+        ],
+      });
+      const url = `http://127.0.0.1:${base + i}`;
+      const adminClient = new SoapboxClient(url, admin);
+      launch(
+        process.env.SOAPBOX_BIN ?? "/tmp/soapbox-target/debug/soapbox",
+        [
+          "serve",
+          "--config",
+          path.join(dir, "coordinator.json"),
+          "--db",
+          path.join(dir, "runtime.db"),
+          "--bind",
+          `127.0.0.1:${base + i}`,
+        ],
+        { ...minimalEnv, MESH_ADMIN: admin, MESH_WORKER: worker },
+      );
+      await until(
+        async () => Boolean(await adminClient.status().catch(() => null)),
+        "coordinator start",
+      );
+      await save(path.join(dir, "worker.json"), {
+        ...workerConfig,
+        memory_mib: 256,
+        ollama_model: null,
+        ollama_digest: null,
+        modes: ["private", "collective"],
+        pools: ["circle"],
+        projects: ["science"],
+        pause_file: path.join(dir, "PAUSE"),
+      });
+      const workerChild = launch(
+        process.env.SOAPBOX_BIN ?? "/tmp/soapbox-target/debug/soapbox",
+        [
+          "worker",
+          "--config",
+          path.join(dir, "worker.json"),
+          "--coordinator",
+          url,
+          "--token-env",
+          "MESH_WORKER",
+        ],
+        { ...minimalEnv, MESH_WORKER: worker },
+      );
+      workers.push({
+        child: workerChild,
+        token: worker,
+        url,
+        config: path.join(dir, "worker.json"),
+      });
+      local = { admin: adminClient, client: (token: string) => new SoapboxClient(url, token) };
+      await until(
+        async () => (await adminClient.status()).nodes?.some((n) => n.online) ?? false,
+        "isolated worker registration",
+      );
+    }
+    backend.push(local);
+    process.env.BITTERBOT_ORCHESTRATOR_IPC_PATH = path.join(dir, "p2p.sock");
+    const bootstrap =
+      i === 0
+        ? []
+        : [`/ip4/127.0.0.1/tcp/${base + 10}/p2p/${(await bridges[0]!.getIdentity()).peerId}`];
+    const bridge = new OrchestratorBridge({
+      enabled: true,
+      orchestratorBinary:
+        process.env.ORCHESTRATOR_BIN ?? "/tmp/bitterbot-mesh-target/debug/bitterbot-orchestrator",
+      keyDir: path.join(dir, "keys"),
+      listenAddrs: [`/ip4/127.0.0.1/tcp/${base + 10 + i}`],
+      httpAddr: `127.0.0.1:${base + 20 + i}`,
+      bootstrapPeers: bootstrap,
+      relayMode: "off",
+    });
+    bridges.push(bridge);
+    await bridge.start();
+    await until(async () => bridge.isConnected(), "IPC connection");
+    const mesh = new ComputeMeshService(
+      bridge,
+      new ComputeMeshStore(path.join(dir, "mesh.db")),
+      () => local,
+    );
+    meshes.push(mesh);
+    await mesh.start();
+    transports.push(
+      startCircleP2pTransport({ bridge, resolveCirclesDb: async () => undefined, compute: mesh }),
+    );
+  }
+  const buyer = meshes[0]!;
+  const buyerId = (await bridges[0]!.getIdentity()).peerId;
+  await until(
+    async () => meshes.every((m) => m.status().peers.length === 2),
+    "signed gossip discovery",
+  );
+  const peerIds = await Promise.all(
+    bridges.slice(1).map(async (b) => (await b.getIdentity()).peerId),
+  );
+  await assert.rejects(buyer.call(peerIds[0]!, "compute/v1/access", {}));
+  for (const mesh of meshes.slice(1)) await mesh.grant(buyerId, ["circle"], ["science"]);
+  const input = Array.from({ length: 40 }, (_, i) => `Private mesh input ${i}`);
+  await until(
+    async () =>
+      peerIds.every((id) => buyer.store.peers().some((p) => p.peerId === id && p.accepting)),
+    "CPU capacity discovery",
+  );
+  const b = buyer.submit({
+    intent: "cpu-private-e2e",
+    kind: "sha256",
+    mode: "private",
+    scope: "circle",
+    inputs: input,
+    peers: peerIds,
+  });
+  await until(async () => completedBatch(buyer, b.id), "multi-operator CPU batch");
+  const completed = buyer.store.batch(b.id)!;
+  assert.equal(new Set(completed.shards.map((s) => s.peerId)).size, 2);
+  assert.equal((completed.result as { hashes: string[] }).hashes.length, 40);
+  const again = buyer.submit({
+    intent: "cpu-private-e2e",
+    kind: "sha256",
+    mode: "private",
+    scope: "circle",
+    inputs: input,
+    peers: peerIds,
+  });
+  assert.equal(again.id, b.id);
+  const collective = buyer.submit({
+    intent: "cpu-collective-e2e",
+    kind: "sha256",
+    mode: "collective",
+    scope: "science",
+    inputs: input,
+    peers: peerIds,
+  });
+  await until(async () => completedBatch(buyer, collective.id), "collective batch");
+  // Gateway restart retains batches and resumes work with the same intent.
+  const recover = buyer.submit({
+    intent: "cpu-recovery-e2e",
+    kind: "sha256",
+    mode: "private",
+    scope: "circle",
+    inputs: input,
+    peers: peerIds,
+  });
+  transports[0]!.stop();
+  await buyer.stop();
+  const recovered = new ComputeMeshService(
+    bridges[0]!,
+    new ComputeMeshStore(path.join(root, "0/mesh.db")),
+    () => null,
+  );
+  meshes[0] = recovered;
+  transports[0] = startCircleP2pTransport({
+    bridge: bridges[0]!,
+    resolveCirclesDb: async () => undefined,
+    compute: recovered,
+  });
+  await recovered.start();
+  await until(async () => completedBatch(recovered, recover.id), "restart recovery");
+  console.log("CPU private, collective and restart recovery passed; starting isolated GPU worker");
+  const gpuWorker = workers[0]!;
+  if (gpuWorker.child.exitCode === null && gpuWorker.child.signalCode === null) {
+    gpuWorker.child.kill("SIGTERM");
+    await until(
+      async () => gpuWorker.child.exitCode !== null || gpuWorker.child.signalCode !== null,
+      "CPU worker shutdown",
+      10000,
+    );
+  }
+  await save(gpuWorker.config, {
+    ...workerConfig,
+    modes: ["private", "collective"],
+    pools: ["circle"],
+    projects: ["science"],
+    pause_file: path.join(root, "1/PAUSE"),
+  });
+  launch(
+    process.env.SOAPBOX_BIN ?? "/tmp/soapbox-target/debug/soapbox",
+    [
+      "worker",
+      "--config",
+      gpuWorker.config,
+      "--coordinator",
+      gpuWorker.url,
+      "--token-env",
+      "MESH_WORKER",
+    ],
+    { ...minimalEnv, MESH_WORKER: gpuWorker.token },
+  );
+  await until(
+    async () =>
+      recovered.store.peers().some((p) => p.accepting && p.gpuSlots > 0 && p.models.length > 0),
+    "GPU readiness discovery",
+    180000,
+  );
+  const advertised = recovered.store
+    .peers()
+    .find((p) => p.accepting && p.gpuSlots > 0 && p.models.length);
+  assert(advertised, "GPU model capacity must be advertised");
+  const model = advertised.models[0]!;
+  const gpu = recovered.submit({
+    intent: "gpu-p2p-e2e",
+    kind: "embeddings",
+    mode: "private",
+    scope: "circle",
+    inputs: ["Bitterbot pooled GPU computation", "Private data stays off gossip"],
+    peers: [advertised.peerId],
+    model: model.model,
+    digest: model.digest,
+  });
+  await until(async () => completedBatch(recovered, gpu.id), "GPU job over encrypted P2P", 180000);
+  await meshes[1]!.revoke(buyerId);
+  await assert.rejects(recovered.call(peerIds[0]!, "compute/v1/access", {}));
+  const report = {
+    test: "real-libp2p-isolated-compute",
+    root,
+    peers: 3,
+    operatorCoordinators: 2,
+    cpuInputs: 40,
+    privateBatch: b.id,
+    collectiveBatch: collective.id,
+    recoveryBatch: recover.id,
+    gpuBatch: gpu.id,
+    gpuResult: recovered.store.batch(gpu.id)?.result,
+    admissionAndRevocation: true,
+    mainnetWalletAccessed: false,
+    paymentsMade: false,
+  };
+  await save(path.join(root, "result.json"), report);
+  console.log(
+    JSON.stringify(
+      { ...report, gpuResult: "2 embedding rows; full result in protected report" },
+      null,
+      2,
+    ),
+  );
+} finally {
+  for (const t of transports) t.stop();
+  for (const m of meshes) await m.stop().catch(() => {});
+  for (const b of bridges) await b.stop().catch(() => {});
+  for (const c of children) c.kill("SIGTERM");
+  await delay(1000);
+  for (const c of children) if (c.exitCode === null) c.kill("SIGKILL");
+}
diff --git a/scripts/install-soapbox-main.mjs b/scripts/install-soapbox-main.mjs
new file mode 100644
index 00000000..9d57d76b
--- /dev/null
+++ b/scripts/install-soapbox-main.mjs
@@ -0,0 +1,129 @@
+/** Local pilot deployment. Prepare is read-only to the live configuration; activate keeps a rollback copy. */
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { cp, mkdir, readFile, rename, writeFile } from "node:fs/promises";
+import { homedir } from "node:os";
+import path from "node:path";
+
+assert.equal(process.platform, "linux", "Run under the main app's Linux/WSL user");
+const root = path.resolve(import.meta.dirname, "..");
+const state = path.join(homedir(), ".bitterbot");
+const target = path.join(state, "compute");
+const configPath = path.join(state, "bitterbot.json");
+const readJson = async (file) => JSON.parse(await readFile(file, "utf8"));
+const digest = (text) => createHash("sha256").update(text).digest("hex");
+const output = path.join(root, "dist/soapbox-integration");
+const action = process.argv[2] ?? "prepare";
+await mkdir(target, { recursive: true, mode: 0o700 });
+const preparedPath = path.join(target, "prepared.json");
+const markerPath = path.join(target, "prepared-state.json");
+if (action === "prepare") {
+  const build = await readJson(path.join(output, "build.json"));
+  const installed = await readJson(path.join(state, "app/current/package.json"));
+  assert.equal(build.version, installed.version, "UI must match the installed release");
+  const original = await readFile(configPath, "utf8");
+  const config = JSON.parse(original);
+  const deployment = path.join(target, `release-${build.version}-${Date.now()}`);
+  await cp(path.join(output, "ui"), path.join(deployment, "ui"), { recursive: true });
+  await cp(path.join(output, "plugin"), path.join(deployment, "plugin"), { recursive: true });
+  config.plugins ??= {};
+  config.plugins.load ??= {};
+  const otherPluginPaths = (config.plugins.load.paths ?? []).filter(
+    (entry) =>
+      !(entry.startsWith(path.join(target, "release-")) && path.basename(entry) === "plugin"),
+  );
+  config.plugins.load.paths = [...new Set([...otherPluginPaths, path.join(deployment, "plugin")])];
+  config.plugins.entries ??= {};
+  config.plugins.entries["soapbox-compute"] = {
+    enabled: true,
+    config: { repository: root, stateDirectory: path.join(homedir(), ".bitterbot-soapbox-pilot") },
+  };
+  if (Array.isArray(config.plugins.allow) && !config.plugins.allow.includes("soapbox-compute"))
+    config.plugins.allow.push("soapbox-compute");
+  config.gateway ??= {};
+  config.gateway.controlUi = {
+    ...config.gateway.controlUi,
+    enabled: true,
+    root: path.join(deployment, "ui"),
+  };
+  assert.deepEqual(config.tools?.wallet, JSON.parse(original).tools?.wallet);
+  await writeFile(preparedPath, JSON.stringify(config, null, 2), { mode: 0o600 });
+  await writeFile(markerPath, JSON.stringify({ original_sha256: digest(original), deployment }), {
+    mode: 0o600,
+  });
+  console.log(`Prepared compatible UI and plugin at ${deployment}; live app unchanged.`);
+} else if (action === "activate") {
+  const marker = await readJson(markerPath);
+  const original = await readFile(configPath, "utf8");
+  assert.equal(
+    digest(original),
+    marker.original_sha256,
+    "Main config changed; prepare again before activating",
+  );
+  const config = await readJson(preparedPath);
+  assert.deepEqual(config.tools?.wallet, JSON.parse(original).tools?.wallet);
+  const pilot = path.join(homedir(), ".bitterbot-soapbox-pilot");
+  const pid = Number(await readFile(path.join(pilot, "launcher.pid"), "utf8"));
+  if (Number.isSafeInteger(pid) && pid > 1) {
+    const cmdline = await readFile(`/proc/${pid}/cmdline`, "utf8").catch(() => "");
+    // A main-app service belongs to the plugin lifecycle; stopping it here races its supervisor.
+    if (
+      cmdline.includes(path.join(root, "scripts/soapbox-desktop-pilot.ts")) &&
+      !cmdline.includes("\0--services-only\0")
+    ) {
+      process.kill(pid, "SIGTERM");
+      for (let i = 0; i < 40; i++) {
+        try {
+          process.kill(pid, 0);
+        } catch {
+          break;
+        }
+        await new Promise((resolve) => setTimeout(resolve, 500));
+      }
+      assert.equal(
+        await readFile(`/proc/${pid}/cmdline`, "utf8").catch(() => ""),
+        "",
+        "Old pilot must stop first",
+      );
+    }
+  }
+  // Keep the existing test identity and spending reservations. Never copy main wallet state.
+  const wallet = path.join(homedir(), ".bitterbot-soapbox/wallet/base-sepolia");
+  await mkdir(wallet, { recursive: true, mode: 0o700 });
+  for (const file of ["wallet-data.json", "tx-history.json"]) {
+    const old = path.join(pilot, "wallet", file);
+    const destination = path.join(wallet, file);
+    try {
+      await cp(old, destination, { errorOnExist: true, force: false });
+    } catch (error) {
+      if (!["EEXIST", "ERR_FS_CP_EEXIST", "ENOENT"].includes(error.code)) throw error;
+    }
+  }
+  const backup = path.join(marker.deployment, "before-config.json");
+  await writeFile(backup, original, { mode: 0o600 });
+  const mainIdentity = await readFile(path.join(state, "wallet/wallet-data.json"), "utf8");
+  await writeFile(path.join(marker.deployment, "main-wallet-before.sha256"), digest(mainIdentity), {
+    mode: 0o600,
+  });
+  await writeFile(`${configPath}.soapbox-next`, JSON.stringify(config, null, 2), { mode: 0o600 });
+  await rename(`${configPath}.soapbox-next`, configPath);
+  await writeFile(
+    path.join(target, "active.json"),
+    JSON.stringify(
+      {
+        url: "http://127.0.0.1:19001/",
+        deployment: marker.deployment,
+        activated_at: new Date().toISOString(),
+      },
+      null,
+      2,
+    ),
+    { mode: 0o600 },
+  );
+  console.log(`Activated Compute. Original configuration retained at ${backup}`);
+  console.log(
+    "The gateway config watcher will restart the app with the plugin. Main wallet configuration is unchanged.",
+  );
+} else {
+  throw new Error("Usage: install-soapbox-main.mjs prepare|activate");
+}
