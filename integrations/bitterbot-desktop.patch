diff --git a/src/infra/soapbox-connection.ts b/src/infra/soapbox-connection.ts
new file mode 100644
index 0000000..6e785db
--- /dev/null
+++ b/src/infra/soapbox-connection.ts
@@ -0,0 +1,62 @@
+import { SoapboxClient, type SoapboxStatus } from "./soapbox-client.js";
+
+/** Portable enrollment file. Contains one scoped API token, never wallet signing keys. */
+export type SoapboxConnection = {
+  version: 1;
+  role: "buyer" | "operator";
+  id: string;
+  url: string;
+  token: string;
+  address: string;
+  chain_id: 84532;
+  escrow: string;
+  escrow_code_sha256: string;
+  rpc_url: string;
+};
+export function parseSoapboxConnection(value: unknown): SoapboxConnection {
+  const c = value as Partial<SoapboxConnection> | null;
+  if (
+    !c ||
+    c.version !== 1 ||
+    !["buyer", "operator"].includes(c.role ?? "") ||
+    !/^[a-zA-Z0-9_-]{1,128}$/.test(c.id ?? "") ||
+    c.chain_id !== 84532 ||
+    !/^0x[\da-f]{40}$/i.test(c.address ?? "") ||
+    /^0x0{40}$/i.test(c.address ?? "") ||
+    !/^0x[\da-f]{40}$/i.test(c.escrow ?? "") ||
+    !/^[\da-f]{64}$/i.test(c.escrow_code_sha256 ?? "") ||
+    typeof c.url !== "string" ||
+    typeof c.token !== "string" ||
+    typeof c.rpc_url !== "string"
+  )
+    throw new Error("Invalid Base Sepolia enrollment file");
+  new SoapboxClient(c.url, c.token);
+  const rpc = new URL(c.rpc_url);
+  if (rpc.protocol !== "https:" || rpc.username || rpc.password || rpc.hash)
+    throw new Error("Payment RPC requires HTTPS without embedded credentials");
+  return c as SoapboxConnection;
+}
+export function verifySoapboxConnection(c: SoapboxConnection, s: SoapboxStatus): void {
+  const role = c.role === "operator" ? "worker" : "submitter";
+  if (
+    s.principal?.id !== c.id ||
+    !s.principal.roles.includes(role) ||
+    s.principal.roles.includes("admin") ||
+    s.principal.roles.some((r) => r !== role) ||
+    s.payment_account?.chain_id !== 84532 ||
+    s.payment_account.address?.toLowerCase() !== c.address.toLowerCase()
+  )
+    throw new Error(
+      "Coordinator identity, role, or testnet payout address does not match enrollment",
+    );
+}
+
+export function soapboxOperatorEnvironment(
+  token: string,
+  env: NodeJS.ProcessEnv,
+): NodeJS.ProcessEnv {
+  const result: NodeJS.ProcessEnv = { SOAPBOX_WORKER_TOKEN: token };
+  for (const key of ["PATH", "HOME", "TMPDIR", "LANG", "XDG_RUNTIME_DIR"])
+    if (env[key]) result[key] = env[key];
+  return result;
+}
diff --git a/src/infra/soapbox-service.ts b/src/infra/soapbox-service.ts
new file mode 100644
index 0000000..040d0dd
--- /dev/null
+++ b/src/infra/soapbox-service.ts
@@ -0,0 +1,105 @@
+import { spawn, type ChildProcess } from "node:child_process";
+import { isAbsolute } from "node:path";
+import { createSubsystemLogger } from "../logging/subsystem.js";
+import { soapboxClientFromEnv } from "./soapbox-client.js";
+
+const log = createSubsystemLogger("soapbox");
+
+/** Optional process ownership. Existing/external coordinators are never stopped. */
+export async function startSoapboxService(
+  env: NodeJS.ProcessEnv = process.env,
+): Promise<() => Promise<void>> {
+  const children: ChildProcess[] = [];
+  const stop = async () => {
+    await Promise.all(
+      children.map(async (child) => {
+        if (child.exitCode !== null || child.signalCode !== null) return;
+        const exited = new Promise<void>((resolve) => child.once("exit", () => resolve()));
+        child.kill("SIGTERM");
+        let timer: NodeJS.Timeout | undefined;
+        await Promise.race([
+          exited,
+          new Promise<void>((resolve) => {
+            timer = setTimeout(resolve, 3000);
+          }),
+        ]);
+        clearTimeout(timer);
+        if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
+      }),
+    );
+  };
+  if (env.BITTERBOT_SOAPBOX_ENABLED !== "1") return stop;
+  try {
+    const client = soapboxClientFromEnv(env);
+    const binary = env.BITTERBOT_SOAPBOX_BINARY;
+    const launch = (args: string[]) => {
+      if (!binary || !isAbsolute(binary))
+        throw new Error("BITTERBOT_SOAPBOX_BINARY must be an absolute path");
+      const childEnv = Object.fromEntries(
+        Object.entries(env).filter(
+          ([key]) =>
+            !/(PRIVATE_KEY|SECRET|MNEMONIC)/i.test(key) &&
+            (/^(SOAPBOX_|BITTERBOT_SOAPBOX_)/.test(key) ||
+              /^(PATH|HOME|USERPROFILE|SYSTEMROOT|WINDIR|TEMP|TMP|TMPDIR|APPDATA|LOCALAPPDATA|LD_LIBRARY_PATH|SSL_CERT_FILE|SSL_CERT_DIR)$/i.test(
+                key,
+              )),
+        ),
+      );
+      const child = spawn(binary, args, {
+        env: childEnv,
+        shell: false,
+        windowsHide: true,
+        stdio: "ignore",
+      });
+      children.push(child);
+      child.on("error", (error) => log.warn(`Soapbox process could not start: ${error.message}`));
+      child.on("exit", (code) => {
+        if (code) log.warn(`Soapbox process exited with code ${code}`);
+      });
+    };
+    if (env.BITTERBOT_SOAPBOX_CONFIG) {
+      if (!env.BITTERBOT_SOAPBOX_DB)
+        throw new Error("BITTERBOT_SOAPBOX_DB is required for a managed coordinator");
+      const url = new URL(env.BITTERBOT_SOAPBOX_URL ?? "http://127.0.0.1:8787");
+      if (url.protocol !== "http:" || url.hostname !== "127.0.0.1") {
+        throw new Error("Managed Soapbox coordinator must use http://127.0.0.1");
+      }
+      launch([
+        "serve",
+        "--config",
+        env.BITTERBOT_SOAPBOX_CONFIG,
+        "--db",
+        env.BITTERBOT_SOAPBOX_DB,
+        "--bind",
+        `127.0.0.1:${url.port || "80"}`,
+      ]);
+      let ready = false;
+      for (let attempt = 0; attempt < 20; attempt++) {
+        if (children[0]?.exitCode !== null && children[0]?.exitCode !== undefined) break;
+        try {
+          await client?.status(500);
+          ready = true;
+          break;
+        } catch {
+          /* startup may still be binding */
+        }
+        await new Promise((resolve) => setTimeout(resolve, 250));
+      }
+      if (!ready) throw new Error("Soapbox coordinator did not become ready");
+    }
+    // A worker is an explicit, separate opt-in to contribute this machine's resources.
+    if (env.BITTERBOT_SOAPBOX_WORKER_CONFIG) {
+      launch([
+        "worker",
+        "--config",
+        env.BITTERBOT_SOAPBOX_WORKER_CONFIG,
+        "--coordinator",
+        env.BITTERBOT_SOAPBOX_URL ?? "http://127.0.0.1:8787",
+      ]);
+    }
+  } catch (error) {
+    await stop();
+    log.warn(`Soapbox integration unavailable: ${String(error)}`);
+  }
+  return stop;
+}
